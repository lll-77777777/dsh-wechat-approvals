{
  "name": "dsh-wechat-plugin",
  "version": "0.43.1-desknotify.1",
  "type": "module",
  "description": "WeChat channel for DeepSeek Harness, forked to relay desktop approval prompts and turn-finished notices to WeChat. Lock the PC, walk away, and drive the agent from your phone.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "wechat",
    "weixin",
    "clawbot",
    "ilink",
    "chatbot",
    "channel",
    "plugin",
    "remote-control"
  ],
  "homepage": "https://github.com/xcisxc29/dsh-wechat#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xcisxc29/dsh-wechat.git"
  },
  "bugs": {
    "url": "https://github.com/xcisxc29/dsh-wechat/issues"
  },
  "main": "lib/host.js",
  "types": "lib/host.d.ts",
  "bin": {
    "dsh-wechat-send": "./cli.js"
  },
  "exports": {
    ".": {
      "types": "./lib/host.d.ts",
      "default": "./lib/host.js"
    },
    "./cli": "./cli.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "dist",
    "cli.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "src"
  ],
  "license": "MIT",
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-home-paths": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  }
}
